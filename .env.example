# ---------- Storage ----------
STORAGE_MODE=azurite

# Real Azure
AZURE_STORAGE_ACCOUNT=your-storage-account-name
AZURE_CONTAINER_RAW=raw
AZURE_CONTAINER_LANDING=landing

# Local emulator
AZURITE_CONNECTION_STRING=UseDevelopmentStorage=true

# ---------- Postgres ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=tillflow
POSTGRES_PASSWORD=tillflow
POSTGRES_DB=retail

# ---------- Pipeline ----------
CHUNK_SIZE=50000
LOG_LEVEL=INFO
